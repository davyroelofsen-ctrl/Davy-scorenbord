<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Wedstrijd Scorebord</title>
<style>
/* Layout: one narrow column, preview first, controls grouped below with hairline dividers. Orange and navy come from De Bataven and the score bug itself. */
:root{--bg:#f2f4f8;--surface:#ffffff;--fg:#0c1a3a;--muted:#5b6682;--line:#d9deea;--accent:#f26a1b;--accent-fg:#ffffff;--field:#ffffff;--shadow:rgba(12,26,58,.12)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#09101f;--surface:#111b36;--fg:#eef1f8;--muted:#9aa5bf;--line:#243050;--accent:#f26a1b;--accent-fg:#ffffff;--field:#0c1530;--shadow:rgba(0,0,0,.5);color-scheme:dark}}
:root[data-theme="dark"]{--bg:#09101f;--surface:#111b36;--fg:#eef1f8;--muted:#9aa5bf;--line:#243050;--accent:#f26a1b;--accent-fg:#ffffff;--field:#0c1530;--shadow:rgba(0,0,0,.5);color-scheme:dark}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--fg);font:16px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;padding-inline:16px;padding-block:20px 40px}
.page{max-width:460px;margin:0 auto;display:flex;flex-direction:column;gap:22px}
h1{font-size:22px;line-height:1.2;margin:0;font-weight:700;letter-spacing:-.01em;text-wrap:balance}
.sub{margin:4px 0 0;color:var(--muted);font-size:14px}
h2{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin:0 0 10px;font-weight:600}
.frame{background:var(--surface);border-radius:14px;padding:10px;box-shadow:0 1px 2px var(--shadow);display:flex;justify-content:center}
canvas{display:block;width:100%;max-width:300px;height:auto;border-radius:8px}
section{display:flex;flex-direction:column}
.grid2{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:12px}
.team{background:var(--surface);border-radius:14px;padding:12px;display:flex;flex-direction:column;align-items:center;gap:8px;min-width:0}
.team input[type=text]{text-align:center;font-weight:600}
.num{font-size:44px;font-weight:700;line-height:1;font-variant-numeric:tabular-nums}
.step{display:flex;gap:8px;width:100%}
.step button{flex:1}
button,.btn{appearance:none;font:inherit;font-weight:600;font-size:15px;min-height:44px;padding:0 14px;border-radius:10px;border:1px solid var(--line);background:var(--surface);color:var(--fg);cursor:pointer;display:inline-flex;align-items:center;justify-content:center;text-align:center}
button:active,.btn:active{transform:scale(.98)}
.primary{background:var(--accent);border-color:var(--accent);color:var(--accent-fg)}
input[type=text],input[type=number]{font:inherit;width:100%;min-height:44px;padding:0 12px;border-radius:10px;border:1px solid var(--line);background:var(--field);color:var(--fg)}
input[type=file]{position:absolute;width:1px;height:1px;opacity:0;overflow:hidden}
label.btn:focus-within,button:focus-visible,input:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.clock{font-size:34px;font-weight:700;text-align:center;font-variant-numeric:tabular-nums;background:var(--surface);border-radius:14px;padding:12px}
.btns{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-top:10px}
.field{display:flex;flex-direction:column;gap:4px;min-width:0}
.field span{font-size:13px;color:var(--muted)}
.hint{font-size:13px;color:var(--muted);margin:8px 0 0}
input[type=range]{width:100%;accent-color:var(--accent);min-height:32px}
.out{background:var(--surface);border-radius:14px;padding:12px;display:flex;flex-direction:column;gap:10px;align-items:center}
.out img{display:block;width:100%;max-width:300px;height:auto;border-radius:8px}
.out p{margin:0;font-size:14px;text-align:center}
@media (prefers-reduced-motion:reduce){button:active,.btn:active{transform:none}}
</style>
</head>
<body>
<main class="page">
  <header>
    <h1>Wedstrijd Scorebord</h1>
    <p class="sub">Zet een scorebord op je wedstrijdfoto voor Instagram.</p>
  </header>

  <div class="frame"><canvas id="cv" width="1080" height="1920" aria-label="Voorbeeld van de foto met scorebord"></canvas></div>

  <section>
    <h2>Stand</h2>
    <div class="grid2">
      <div class="team">
        <input type="text" id="n1" value="BAT 4" aria-label="Naam links">
        <div class="num" id="v1">0</div>
        <div class="step"><button id="m1" aria-label="Score links min één">−</button><button id="p1" class="primary" aria-label="Score links plus één">+</button></div>
      </div>
      <div class="team">
        <input type="text" id="n2" value="MASV 4" aria-label="Naam rechts">
        <div class="num" id="v2">0</div>
        <div class="step"><button id="m2" aria-label="Score rechts min één">−</button><button id="p2" class="primary" aria-label="Score rechts plus één">+</button></div>
      </div>
    </div>
  </section>

  <section>
    <h2>Tijd</h2>
    <div class="clock" id="tm">00:00</div>
    <div class="btns"><button id="go" class="primary">Start</button><button id="pa">Pauze</button><button id="rs">Reset</button></div>
    <div class="grid2" style="margin-top:12px">
      <label class="field"><span>Minuten</span><input type="number" id="mm" value="0" min="0" step="1" inputmode="numeric"></label>
      <label class="field"><span>Seconden</span><input type="number" id="ss" value="0" min="0" max="59" step="1" inputmode="numeric"></label>
    </div>
    <p class="hint">Vul de tijd in en de klok springt er direct naartoe.</p>
  </section>

  <section>
    <h2>Foto en logo's</h2>
    <div class="grid2">
      <label class="btn primary" style="grid-column:1/-1">Kies foto van de baan<input type="file" id="photo" accept="image/*"></label>
      <label class="btn">Logo links<input type="file" id="l1" accept="image/*"></label>
      <label class="btn">Logo rechts<input type="file" id="l2" accept="image/*"></label>
    </div>
    <p class="hint">De logo's van De Bataven en MASV staan er al in. Kies hier een ander logo om ze te vervangen.</p>
  </section>

  <section>
    <h2>Opmaak</h2>
    <div class="grid2">
      <label class="field"><span>Afstand van boven</span><input type="range" id="py" min="30" max="400" value="70" step="5"></label>
      <label class="field"><span>Grootte</span><input type="range" id="sz" min="70" max="150" value="100" step="5"></label>
    </div>
  </section>

  <section>
    <button id="mk" class="primary">Maak afbeelding</button>
    <div class="out" id="out" hidden style="margin-top:12px">
      <img id="res" alt="Klare afbeelding met scorebord">
      <p>Houd de afbeelding ingedrukt en kies Bewaar in Foto's.</p>
    </div>
  </section>
</main>
<script>
const cv=document.getElementById('cv'),c=cv.getContext('2d');
const W=1080,H=1920,$=id=>document.getElementById(id);
let photo=null,elapsed=0,t0=0,run=false,iv=null,fit1=0.86,fit2=1.0,sc1=0,sc2=0;
let logo1=new Image(),logo2=new Image();
logo1.onload=()=>draw();logo2.onload=()=>draw();logo1.onerror=()=>draw();logo2.onerror=()=>draw();
logo1.src='data:image/jpeg;base64,';
logo2.src='data:image/png;base64,';
function loadUp(inp,cb){const f=inp.files[0];if(!f)return;const r=new FileReader();r.onload=ev=>{const i=new Image();i.onload=()=>{cb(i);draw()};i.src=ev.target.result};r.readAsDataURL(f)}
$('photo').onchange=e=>loadUp(e.target,i=>{photo=i});
$('l1').onchange=e=>loadUp(e.target,i=>{logo1=i;fit1=0.9});
$('l2').onchange=e=>loadUp(e.target,i=>{logo2=i;fit2=0.9});
['n1','n2','py','sz'].forEach(id=>$(id).addEventListener('input',draw));
function bump(which,d){if(which===1)sc1=Math.max(0,sc1+d);else sc2=Math.max(0,sc2+d);$('v1').textContent=sc1;$('v2').textContent=sc2;draw()}
$('m1').onclick=()=>bump(1,-1);$('p1').onclick=()=>bump(1,1);$('m2').onclick=()=>bump(2,-1);$('p2').onclick=()=>bump(2,1);
function fmt(){const s=Math.floor(elapsed/1000);return String(Math.floor(s/60)).padStart(2,'0')+':'+String(s%60).padStart(2,'0')}
function rr(x,y,w,h,r){c.beginPath();c.moveTo(x+r,y);c.arcTo(x+w,y,x+w,y+h,r);c.arcTo(x+w,y+h,x,y+h,r);c.arcTo(x,y+h,x,y,r);c.arcTo(x,y,x+w,y,r);c.closePath()}
const FF='Arial, Helvetica, sans-serif';
function crest(img,cx,cy,r,fit,fb){
  c.save();c.beginPath();c.arc(cx,cy,r,0,7);c.fillStyle='#fff';c.fill();c.clip();
  if(img.complete&&img.naturalWidth>0){const k=Math.min((2*r*fit)/img.width,(2*r*fit)/img.height);const w=img.width*k,h=img.height*k;c.drawImage(img,cx-w/2,cy-h/2,w,h)}
  else{c.beginPath();c.arc(cx,cy,r-2,0,7);c.lineWidth=4;c.strokeStyle='#d62828';c.stroke();c.fillStyle='#d62828';c.font='800 13px '+FF;c.textAlign='center';c.textBaseline='middle';c.fillText(fb,cx,cy)}
  c.restore();
}
function draw(){
  c.setTransform(1,0,0,1,0,0);c.clearRect(0,0,W,H);
  if(photo){const k=Math.max(W/photo.width,H/photo.height);const w=photo.width*k,h=photo.height*k;c.drawImage(photo,(W-w)/2,(H-h)/2,w,h)}
  else{const g=c.createLinearGradient(0,0,0,H);g.addColorStop(0,'#7db9ee');g.addColorStop(0.65,'#a7d46f');g.addColorStop(1,'#4f9a3a');c.fillStyle=g;c.fillRect(0,0,W,H);c.fillStyle='rgba(255,255,255,0.85)';c.font='600 40px '+FF;c.textAlign='center';c.textBaseline='middle';c.fillText('Kies een foto',W/2,H/2)}
  const sc=($('sz').value||100)/100,X=40,Y=+$('py').value;
  c.setTransform(sc,0,0,sc,X,Y);
  const n1=($('n1').value||'').toUpperCase(),n2=($('n2').value||'').toUpperCase();
  const h=62,cr=23,pad=12,timeW=120,scoreW=116;
  c.font='700 27px '+FF;
  const w1=c.measureText(n1).width,w2=c.measureText(n2).width;
  const homeW=pad+cr*2+10+w1+18,awayW=18+w2+10+cr*2+pad;
  const total=timeW+homeW+scoreW+awayW;
  c.save();c.shadowColor='rgba(0,0,0,0.40)';c.shadowBlur=18;c.shadowOffsetY=6;
  rr(0,0,total,h,12);c.fillStyle='#0c1a3a';c.fill();c.restore();
  c.save();rr(0,0,total,h,12);c.clip();
  c.fillStyle='#f26a1b';c.fillRect(0,0,timeW,h);
  c.fillStyle='rgba(255,255,255,0.14)';c.fillRect(0,0,timeW,h*0.5);
  c.fillStyle='#ffffff';c.fillRect(timeW+homeW,0,scoreW,h);
  c.fillStyle='rgba(255,255,255,0.08)';c.fillRect(timeW,0,homeW,h*0.5);c.fillRect(timeW+homeW+scoreW,0,awayW,h*0.5);
  c.fillStyle='#f26a1b';c.fillRect(timeW+homeW,h-4,scoreW,4);
  c.restore();
  c.textBaseline='middle';c.textAlign='center';
  c.fillStyle='#fff';c.font='700 30px '+FF;c.fillText(fmt(),timeW/2,h/2+1);
  crest(logo1,timeW+pad+cr,h/2,cr,fit1,'BAT');
  c.textAlign='left';c.fillStyle='#fff';c.font='700 27px '+FF;
  c.fillText(n1,timeW+pad+cr*2+10,h/2+1);
  c.textAlign='center';c.fillStyle='#0c1a3a';c.font='800 40px '+FF;
  c.fillText(String(sc1),timeW+homeW+scoreW/2-30,h/2-1);
  c.fillText(String(sc2),timeW+homeW+scoreW/2+30,h/2-1);
  c.font='700 30px '+FF;c.fillStyle='#8a93a8';c.fillText('-',timeW+homeW+scoreW/2,h/2-2);
  c.textAlign='left';c.fillStyle='#fff';c.font='700 27px '+FF;
  c.fillText(n2,timeW+homeW+scoreW+18,h/2+1);
  crest(logo2,timeW+homeW+scoreW+awayW-pad-cr,h/2,cr,fit2,'MASV');
  c.setTransform(1,0,0,1,0,0);
}
function tick(){elapsed=Date.now()-t0;$('tm').textContent=fmt();draw()}
$('go').onclick=()=>{if(run)return;run=true;t0=Date.now()-elapsed;iv=setInterval(tick,250)};
$('pa').onclick=()=>{run=false;clearInterval(iv)};
$('rs').onclick=()=>{run=false;clearInterval(iv);elapsed=0;$('tm').textContent=fmt();draw()};
function setT(){const m=Math.max(0,parseInt($('mm').value)||0),s=Math.min(59,Math.max(0,parseInt($('ss').value)||0));elapsed=(m*60+s)*1000;if(run)t0=Date.now()-elapsed;$('tm').textContent=fmt();draw()}
$('mm').addEventListener('input',setT);$('ss').addEventListener('input',setT);
$('mk').onclick=()=>{draw();$('res').src=cv.toDataURL('image/png');$('out').hidden=false;$('out').scrollIntoView({behavior:'smooth',block:'nearest'})};
draw();
</script>
</body>
</html>

